# AI: только обслуживание Optima. WEB proxy НЕ ТРОГАТЬ; сохранять /telegram/web/ и include прокси в Nginx. См. AGENTS.md.
[Unit]
Description=Renew procurement IP TLS certificate
After=docker.service nginx.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm -v /etc/letsencrypt:/etc/letsencrypt -v /var/lib/letsencrypt:/var/lib/letsencrypt -v /var/log/letsencrypt:/var/log/letsencrypt -v /var/www/procurement-acme:/var/www/procurement-acme certbot/certbot:v5.4.0 renew --quiet --no-random-sleep-on-renew
ExecStartPost=/usr/sbin/nginx -s reload
